{
  "name": "oracle-application-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "node src/server.js",
    "dev:web": "vite --config web/vite.config.js",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "build": "vite build --config web/vite.config.js",
    "start": "node src/server.js",
    "test": "node --test",
    "seed": "node src/cli.js seed",
    "ingest": "node src/cli.js ingest",
    "ingest:jobs": "node src/cli.js ingest",
    "auth": "node src/cli.js auth",
    "scan": "node src/cli.js scan",
    "scan:queue": "node src/cli.js scan:queue",
    "resolve": "node src/cli.js resolve",
    "resolve:answers": "node src/cli.js resolve",
    "prepare:application": "node src/cli.js prepare",
    "parse:resumes": "node scripts/parse-resumes.js",
    "fetch:clients": "node scripts/fetch_clients.mjs",
    "sync:cas": "node scripts/fetch_cas.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "playwright": "^1.56.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "vite": "^7.2.0"
  }
}
